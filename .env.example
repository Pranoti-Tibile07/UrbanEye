# ============================================================
# UrbanEye environment variables
# ------------------------------------------------------------
# Copy this file to ".env" in the project root and fill in
# real values. Never commit the real ".env" file.
# ============================================================

# --- Gemini AI -------------------------------------------------
# REQUIRED for AI image analysis. This key is read by Ai_/urbaneye_ai.py,
# which looks for a .env file in Ai_/ first and then walks up to the
# project root. You can put this line in Ai_/.env OR in the root .env.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Authentication ---------------------------------------------
# Secret used to sign JWT tokens. In production ALWAYS set a long,
# random value. If left empty, the backend generates an ephemeral
# random secret at startup (logins will not survive a restart).
JWT_SECRET=
# Token lifetime in minutes (default: 1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440

# --- Database ---------------------------------------------------
# SQLite for local development (default). Swap for PostgreSQL later, e.g.:
#   postgresql+psycopg://user:password@localhost:5432/urbaneye
DATABASE_URL=sqlite:///./urbaneye.db

# --- Uploads ----------------------------------------------------
# Folder where uploaded issue images are stored (default: ./uploads)
UPLOAD_DIR=./uploads
# Maximum accepted image size in megabytes (default: 10)
MAX_UPLOAD_MB=10

# --- CORS -------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Demo seed data ---------------------------------------------
# Used by: python -m backend.seed
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@urbaneye.com
SEED_ADMIN_PASSWORD=admin123
